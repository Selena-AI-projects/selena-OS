{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selenasystems.com/contracts/control-room-event.v1.1.schema.json",
  "title": "Aether → Control Room event envelope, version 1.1",
  "description": "Конверт версии 1 без изменений плюс событие о материале content.draft_ready. Получатель, знающий только версию 1, обязан отвергать этот конверт целиком; получатель версии 1.1 принимает и конверты версии 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "project_id",
    "aggregate_id",
    "version",
    "occurred_at",
    "trace_id",
    "payload",
    "payload_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.1", "description": "Версия конверта." },
    "event_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "description": "Ключ идемпотентности на проводе." },
    "event_type": {
      "type": "string",
      "enum": ["task.result.ready", "content.draft_ready"],
      "description": "task.result.ready — результат задачи готов к разбору (нагрузка версии 1). content.draft_ready — готова версия одного материала; ни то ни другое не является одобрением или публикацией."
    },
    "project_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "description": "Проект Aether. Для материалов — ключ поиска binding в Control Room вместе со средой источника." },
    "aggregate_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Для task.result.ready — задача. Для content.draft_ready — материал: uuid5(2f7f0f5e-6b1a-5c3a-9c2e-1d4b7a8e9f01, \"<brief_ref>:<content_kind>\"); получатель пересчитывает и сверяет."
    },
    "version": { "type": "integer", "minimum": 1, "description": "Монотонная версия агрегата (задачи или материала). Совпадает с content_versions.version в Control Room." },
    "occurred_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "payload": { "type": "object" },
    "payload_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 канонизированной нагрузки; получатель пересчитывает сам." }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "task.result.ready" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/task_result_payload" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "content.draft_ready" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/content_draft_payload" } } }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "https_url": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
    "task_result_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "status", "summary"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "status": { "type": "string", "enum": ["pending_approval", "approved", "rejected", "done"] },
        "summary": { "type": "string", "maxLength": 4000 },
        "artifact_count": { "type": "integer", "minimum": 0 }
      }
    },
    "content_draft_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_kind", "title", "language", "body_markdown", "metadata", "claims", "evidence", "qa_results", "source", "brief_ref", "business_key"],
      "properties": {
        "content_kind": { "type": "string", "enum": ["ARTICLE", "SOCIAL_ADAPTATION", "BRIEF", "PAGE_UPDATE", "VIDEO_SCRIPT"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "maxLength": 16 },
        "body_markdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48000,
          "description": "Только inline-тело. Предел — 48 000 байт UTF-8; схема ограничивает символы, байты проверяет код обеих сторон. Ссылки на артефакты в этой версии не передаются."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cta_url"],
          "properties": {
            "cta_url": { "$ref": "#/$defs/https_url", "description": "Обязателен: абсолютный https без учётных данных и fragment; становится content_versions.cta_url." },
            "slug": { "type": "string", "maxLength": 200 },
            "meta_title": { "type": "string", "maxLength": 200 },
            "meta_description": { "type": "string", "maxLength": 500 },
            "internal_links": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/https_url" } }
          }
        },
        "claims": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "status"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 500 },
              "status": { "type": "string", "enum": ["EXTRACTED", "INTERPRETED", "HYPOTHESIS", "UNKNOWN"] },
              "source_ref": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref", "captured_at"],
            "properties": {
              "kind": { "type": "string", "minLength": 1, "maxLength": 50 },
              "ref": { "type": "string", "minLength": 1, "maxLength": 500 },
              "captured_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "qa_results": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "description": "Ровно шесть проверок, каждая один раз. PASS не является разрешением выпуска; FAIL и UNKNOWN блокируют release gate.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "verdict"],
            "properties": {
              "check": { "type": "string", "enum": ["FACTS", "LINKS", "NOVELTY", "BRAND", "TECHNICAL", "ISOLATION"] },
              "verdict": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
              "detail": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "rights"],
          "properties": {
            "kind": { "type": "string", "enum": ["OWN", "EXTERNAL", "SYNTHETIC_FIXTURE"] },
            "ref": { "type": "string", "minLength": 1, "maxLength": 500 },
            "rights": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "brief_ref": { "$ref": "#/$defs/uuid", "description": "Задание, породившее материал; общий для статьи и её адаптации." },
        "business_key": { "type": "string", "pattern": "^[a-z_]{2,32}$", "description": "Проверочный alias бизнеса. Сверяется с binding, но не выбирает организацию или бренд." }
      }
    }
  }
}
